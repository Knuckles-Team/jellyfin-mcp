@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:comment """The author of one or more :Book items. Aligned to schema:Person /
foaf:Person (CONCEPT:KG-2.163).""" ;
    rdfs:seeAlso foaf:Person ;
    rdfs:subClassOf foaf:Person .

:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment """A book / audiobook item in an Audiobookshelf :Library, authored_by an
:Author. A specialization of :MediaItem. Aligned to schema:Book / bibo:Book
(CONCEPT:KG-2.163).""" ;
    rdfs:seeAlso schema:Book ;
    rdfs:subClassOf :MediaItem .

:Library a owl:Class ;
    rdfs:label "Library" ;
    rdfs:comment """An Audiobookshelf library (a collection of :Book items of one
media type — audiobooks or ebooks). BFO:IndependentContinuant via System
(CONCEPT:KG-2.163).""" ;
    rdfs:subClassOf :System .

:addedDate a owl:DatatypeProperty ;
    rdfs:label "added date" ;
    rdfs:domain :DownloadJob ;
    rdfs:range xsd:dateTime .

:attachedToMessage a owl:ObjectProperty ;
    rdfs:label "attached to message" ;
    rdfs:comment """Links an :AssetOccurrence to the chat :Memory (ChatMessage) it arrived on,
so "show me the chart they sent yesterday" resolves media from the conversation
(CONCEPT:KG-2.251).""" ;
    rdfs:domain :AssetOccurrence ;
    rdfs:range :Memory .

:belongsToCollection a owl:ObjectProperty ;
    rdfs:label "belongs to collection" ;
    rdfs:domain :MediaItem ;
    rdfs:range :MediaCollection .

:completedDate a owl:DatatypeProperty ;
    rdfs:label "completed date" ;
    rdfs:domain :DownloadJob ;
    rdfs:range xsd:dateTime .

:contentDigest a owl:DatatypeProperty ;
    rdfs:label "content digest" ;
    rdfs:comment """The content address (hex digest) of a :Blob in the engine BLOB
substrate — the stable, dedup key the bytes are fetched back by (CONCEPT:KG-2.206).""" ;
    rdfs:domain :Blob ;
    rdfs:range xsd:string .

:downloadProgress a owl:DatatypeProperty ;
    rdfs:label "download progress (%)" ;
    rdfs:domain :DownloadJob ;
    rdfs:range xsd:float .

:downloadStatus a owl:DatatypeProperty ;
    rdfs:label "download status" ;
    rdfs:comment "Values: queued, downloading, seeding, completed, error." ;
    rdfs:domain :DownloadJob ;
    rdfs:range xsd:string .

:downloadUrl a owl:DatatypeProperty ;
    rdfs:label "download URL" ;
    rdfs:domain :DownloadJob ;
    rdfs:range xsd:anyURI .

:downloadedVia a owl:ObjectProperty ;
    rdfs:label "downloaded via" ;
    rdfs:comment "Links an AssetOccurrence to the download System used." ;
    rdfs:domain :AssetOccurrence ;
    rdfs:range :System .

:fileSizeBytes a owl:DatatypeProperty ;
    rdfs:label "file size (bytes)" ;
    rdfs:domain :AssetOccurrence ;
    rdfs:range xsd:long .

:hasBlob a owl:ObjectProperty ;
    rdfs:label "has blob" ;
    rdfs:comment """Links an :AssetOccurrence to the content-addressed :Blob holding its bytes.
Maintains the engine blob refcount (BlobRef) so a referenced blob is never GC'd
(CONCEPT:KG-2.251).""" ;
    rdfs:domain :AssetOccurrence ;
    rdfs:range :Blob .

:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by" ;
    rdfs:comment "Links a MediaItem to its MediaLibrary." ;
    rdfs:domain :MediaItem ;
    rdfs:range :MediaLibrary .

:mediaType a owl:DatatypeProperty ;
    rdfs:label "media type" ;
    rdfs:comment "MIME type or category: video/mp4, audio/flac, application/pdf." ;
    rdfs:domain :AssetOccurrence ;
    rdfs:range xsd:string .

:producedAsset a owl:ObjectProperty ;
    rdfs:label "produced asset" ;
    rdfs:comment "Links a DownloadJob to the AssetOccurrence it created." ;
    rdfs:domain :DownloadJob ;
    rdfs:range :AssetOccurrence .

:requestedBy a owl:ObjectProperty ;
    rdfs:label "requested by" ;
    rdfs:comment "Links a DownloadJob to the Person who requested it." ;
    rdfs:domain :DownloadJob ;
    rdfs:range :Person .

<http://knuckles.team/kg/media> a owl:Ontology ;
    rdfs:label "Media & Downloads Ontology" ;
    rdfs:comment """Media asset management and download tracking ontology bridging
qBittorrent (torrent downloads), Jellyfin (media library), and media
downloader into the unified KG.

Tracks download jobs, media assets, and their consumption patterns.

Standards alignment: schema:MediaObject, schema:DownloadAction.""" ;
    owl:imports <http://knuckles.team/kg> .

:MediaCollection a owl:Class ;
    rdfs:label "Media Collection" ;
    rdfs:comment "A curated collection within a MediaLibrary (TV shows, movies, music)." ;
    rdfs:subClassOf :Dataset .

:MediaLibrary a owl:Class ;
    rdfs:label "Media Library" ;
    rdfs:comment """A media management system (Jellyfin, Plex). Organizes
MediaItems into collections. BFO:IndependentContinuant via System.""" ;
    rdfs:subClassOf :System .

:Blob a owl:Class ;
    rdfs:label "Blob" ;
    rdfs:comment """A content-addressed, deduplicated binary stored in the engine BLOB
substrate (CONCEPT:KG-2.206), keyed by its content digest. The same bytes (an image,
a voice note, a chart) resolve to ONE :Blob no matter how many :AssetOccurrences reference
it. The bytes live in the engine, beside the graph; this node is the graph-side handle
(its digest) so the blob is discoverable + GC-refcounted from the ontology
(CONCEPT:KG-2.251).""" ;
    rdfs:subClassOf :Dataset .

:DownloadJob a owl:Class ;
    rdfs:label "Download Job" ;
    rdfs:comment """A download task tracked in qBittorrent or media-downloader.
BFO:Process via Action. Aligned to schema:DownloadAction.""" ;
    rdfs:seeAlso schema:DownloadAction ;
    rdfs:subClassOf :Action .

:MediaItem a owl:Class ;
    rdfs:label "Media Item" ;
    rdfs:comment """A catalog item managed by a media library (video, audio, book,
series, or collection entry). Its source-system identity is distinct from any
:AssetOccurrence that records observed bytes such as artwork or a downloaded file.
Aligned to schema:MediaObject.""" ;
    rdfs:seeAlso schema:MediaObject ;
    rdfs:subClassOf :Dataset .

:Artist a owl:Class ;
    rdfs:label "Artist" ;
    rdfs:comment """A performer / musical artist credited on one or more :MediaItem
items in a Jellyfin :MediaLibrary (audio tracks, albums, music videos). Aligned to
schema:MusicGroup / foaf:Agent (CONCEPT:KG-2.163).""" ;
    rdfs:seeAlso schema:MusicGroup ;
    rdfs:subClassOf foaf:Agent .

:Genre a owl:Class ;
    rdfs:label "Genre" ;
    rdfs:comment """A media genre (e.g. Drama, Jazz, Science Fiction) tagged on a
:MediaItem. A SKOS concept in the media classification scheme.""" ;
    rdfs:seeAlso skos:Concept ;
    rdfs:subClassOf skos:Concept .

:itemKind a owl:DatatypeProperty ;
    rdfs:label "item kind" ;
    rdfs:comment """The Jellyfin item type of a :MediaItem: Movie, Episode, Series,
Audio, MusicAlbum, Book, etc.""" ;
    rdfs:domain :MediaItem ;
    rdfs:range xsd:string .

:communityRating a owl:DatatypeProperty ;
    rdfs:label "community rating" ;
    rdfs:domain :MediaItem ;
    rdfs:range xsd:float .

:productionYear a owl:DatatypeProperty ;
    rdfs:label "production year" ;
    rdfs:domain :MediaItem ;
    rdfs:range xsd:integer .

:hasGenre a owl:ObjectProperty ;
    rdfs:label "has genre" ;
    rdfs:comment "Links a :MediaItem to a :Genre it is classified under." ;
    rdfs:domain :MediaItem ;
    rdfs:range :Genre .

:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by" ;
    rdfs:comment "Links an audio :MediaItem to the :Artist that performed it." ;
    rdfs:domain :MediaItem ;
    rdfs:range :Artist .

:authoredBy a owl:ObjectProperty ;
    rdfs:label "authored by" ;
    rdfs:comment "Links a :Book to its :Author." ;
    rdfs:domain :Book ;
    rdfs:range :Author .
